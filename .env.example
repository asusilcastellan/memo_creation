# Copy this file to ".env" (same folder as main.py, or next to the built .exe) and fill it in.
# Never commit or share the real .env.

OPENAI_API_KEY=

# Optional model overrides (otherwise resources/config/settings.yaml is used)
# OPENAI_MODEL_EXTRACT=
# OPENAI_MODEL_WRITE=

# --- Dropbox API -------------------------------------------------------------
# Recommended: a long-lived REFRESH token (run: python tools/dropbox_get_refresh_token.py)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Alternative: an access token from the Dropbox App Console ("Generate" button).
# These expire after ~4 hours, so only use one for quick testing.
DROPBOX_ACCESS_TOKEN=

# Team Dropbox ("Castellan Dropbox" team space): list paths from the team root, exactly as the
# desktop app shows them, e.g. /Bridge Lending/Current Portfolio/150 E Aurora St
DROPBOX_USE_TEAM_ROOT=true

# --- Microsoft Graph: read the broker / borrower email thread from Outlook (optional) ----------
# Azure portal -> App registrations -> New registration (single tenant). Then:
#   API permissions -> Microsoft Graph -> Application permissions -> Mail.Read -> Grant admin consent
#   Certificates & secrets -> New client secret (copy the VALUE, not the secret ID)
# Without these, only .eml / .msg files saved in the deal folder are read.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Mailboxes to search, comma-separated (the analysts / deal inbox), e.g. deals@castellanre.com,analyst@castellanre.com
GRAPH_MAILBOXES=

# --- Index rates (optional) --------------------------------------------------------------------
# SOFR comes from the NY Fed public API (no key). For a live WSJ Prime rate get a free key at
# https://fred.stlouisfed.org/docs/api/api_key.html ; without it rules.prime_rate_pct in settings.yaml is used.
FRED_API_KEY=
